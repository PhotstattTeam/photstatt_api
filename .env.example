# 服务监听端口（默认 8081，避开本机已占用的 8080）
PORT=8081

# SQLite 数据库文件路径
DB_PATH=consiliumous.db

# JWT 签名密钥（生产环境务必改为随机长字符串）
JWT_SECRET=dev-secret-change-me

# 跨域白名单（逗号分隔），* 表示全部（仅开发环境使用）
CORS_ALLOWED_ORIGINS=*

# 系统管理员（全局唯一角色，系统初始化时指定，见 PRD 3.2）
# 启动时：该邮箱用户已存在则自动提升为系统管理员；不存在且提供了密码则自动创建
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
