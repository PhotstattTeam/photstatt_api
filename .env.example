# ---------- 应用 ----------
APP_NAME=photstatt_api
APP_ENV=development
APP_PORT=8080
# debug / release / test
GIN_MODE=debug

# ---------- 数据库（Postgres）----------
# 本机 brew 服务与 docker-compose.yml 使用同一套账号密码，二选一启动即可
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=photstatt
DB_PASSWORD=photstatt_dev_pw
DB_NAME=photstatt
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

# 连接池
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
# Go duration 格式，例如 30m、1h
DB_CONN_MAX_LIFETIME=30m

# ---------- 跨域 ----------
# Vue dev server（5173）与 Flutter Web，逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
